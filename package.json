{
  "name": "billingo-mcp",
  "version": "2.0.0",
  "description": "MCP server for Billingo API v3",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "billingo-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
